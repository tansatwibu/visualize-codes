# Example environment variables
# Paste a real MongoDB connection string here. When set, server reads data from Mongo.
MONGO_URI=mongodb://localhost:27017/
MONGO_DBNAME=sample_db
MONGO_COLLECTION=transaction

# Optional: restrict CORS to a specific origin (e.g. https://example.com). Leave empty to allow all origins.
#CORS_ORIGIN=https://your-frontend-host

# Port and host
PORT=3000
#HOST=0.0.0.0
